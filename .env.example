# Kafka and topic settings
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
RAW_TOPIC=transactions.raw
REPLAY_TOPIC=transactions.replay
ALERT_TOPIC=alerts.fraud
AGGREGATE_TOPIC=transactions.aggregates
DLQ_TOPIC=transactions.dlq
SCHEMA_REGISTRY_URL=http://localhost:8085
CONNECT_URL=http://localhost:8083
METRIC_TOPICS=transactions.raw,transactions.replay,transactions.aggregates,alerts.fraud,transactions.dlq,merchant_risk_profiles
READABLE_TOPICS=transactions.raw,transactions.replay,transactions.aggregates,alerts.fraud,transactions.dlq,merchant_risk_profiles
FLINK_CONSUMER_GROUP=flink-realtime-lab
SINK_DELIVERY_GUARANTEE=AT_LEAST_ONCE
KAFKA_ISOLATION_LEVEL=read_uncommitted
MAX_FUTURE_SKEW_SECONDS=300
DEDUPLICATION_TTL_HOURS=24

# Replay identity and consumer group
REPLAYER_GROUP_ID=realtime-lab-replayer
REPLAY_RUN_ID=replay-run-local
REPLAY_SCAN_TIMEOUT_SECONDS=20

# Risk rule thresholds
RISK_HIGH_FRAUD_SCORE=0.92
RISK_HIGH_AMOUNT=1000.0
RISK_HIGH_IP_RISK=80
RISK_BURST_COUNT_THRESHOLD=5
RISK_BURST_AMOUNT_THRESHOLD=3000.0
RISK_MERCHANT_COUNT_THRESHOLD=25
RISK_MERCHANT_AMOUNT_THRESHOLD=15000.0
RISK_MERCHANT_AVG_FRAUD_SCORE_THRESHOLD=0.72

# Local-only credentials. Replace these values before exposing any service.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Empty keeps the local API unauthenticated. Set a strong value for shared environments.
API_TOKEN=
